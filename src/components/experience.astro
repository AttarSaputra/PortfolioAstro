---
interface Experience {
  company: string;
  role: string;
  period: string;
  description: string;
  link: string;
  preview: string;
  status: string;
  skills?: string[];
}

const experiences: Experience[] = [
  {
    company: "AWBS Media",
    role: "Paid Ads Executive",
    period: "Apr 2025 — Present",
    description:
      "Managed digital ad campaigns on Meta and Google, optimized audience targeting, bidding, and budgets, and monitored performance to improve CTR, ROAS, and lead quality through testing and reporting.",
    link: "https://github.com/AttarSaputra",
    preview: "https://www.linkedin.com/in/muhammad-attar-syahputra/",
    status: "Full-time",
    skills: ["Meta Ads", "Google Ads", "GA4", "A/B Testing"],
  },
  {
    company: "Englishvit",
    role: "Full Stack Web Developer",
    period: "Dec 2024 — Mar 2025",
    description:
      "Developed and maintained web applications, optimized performance, integrated APIs and databases, and collaborated with teams to deliver secure, user-focused solutions.",
    link: "https://github.com/AttarSaputra",
    preview: "https://www.linkedin.com/in/muhammad-attar-syahputra/",
    status: "Contract",
    skills: ["TypeScript", "Astro", "PostgreSQL", "REST API"],
  },
  {
    company: "Berlima Digital",
    role: "Marketplace Specialist",
    period: "May 2024 — October 2024",
    description:
      "Managed marketplace campaigns and optimized product listings to improve visibility, traffic, and conversion performance across digital sales channels.",
    link: "https://github.com/AttarSaputra",
    preview: "https://www.linkedin.com/in/muhammad-attar-syahputra/",
    status: "Contract",
    skills: ["Marketplace Ads", "SEO", "Analytics"],
  },
  {
    company: "Bio Industries",
    role: "Marketplace Advertiser",
    period: "Aug 2022 — Jan 2024",
    description:
      "Managed marketplace advertising campaigns and product promotion across e-commerce channels, optimized listings and campaign performance, and supported sales growth through improved visibility and conversion-focused strategies.",
    link: "https://github.com/AttarSaputra",
    preview: "https://www.linkedin.com/in/muhammad-attar-syahputra/",
    status: "Contract",
    skills: ["Campaign Ads", "Product Listing", "Reporting"],
  },
  {
    company: "GMEDIA",
    role: "Full Stack Web Developer",
    period: "Jan 2021 — Jan 2022",
    description:
      "Built and maintained web applications with a focus on frontend experience and backend functionality, integrated APIs, and improved product reliability through clean implementation and iterative updates.",
    link: "https://github.com/AttarSaputra",
    preview: "https://www.linkedin.com/in/muhammad-attar-syahputra/",
    status: "Contract",
    skills: ["JavaScript", "PHP", "MySQL", "REST API"],
  },
  {
    company: "Internship",
    role: "Junior Web Developer",
    period: "Feb 2020 — Jul 2020",
    description:
      "Developed basic web interfaces and supported frontend implementation, learned team workflows, and contributed to simple project updates under supervision while improving coding and UI practices.",
    link: "https://github.com/AttarSaputra",
    preview: "https://www.linkedin.com/in/muhammad-attar-syahputra/",
    status: "Internship",
    skills: ["HTML", "CSS", "JavaScript"],
  },
];
---

<section
  id="experience"
  class="py-12 border-t border-white/10 text-[var(--white)]"
>
  <div class="max-w-5xl mx-auto">
    <h2 class="text-lg text-[var(--sec)] mb-2 shiny-sec">Work Experience</h2>
    <h3 class="text-4xl md:text-5xl font-medium mb-10">Experience</h3>

    <div class="relative mt-8 md:mt-10">
      <!-- timeline spine -->
      <div class="absolute left-[7px] top-2 bottom-2 w-px bg-white/10"></div>

      <div class="space-y-3">
        {
          experiences.map((experience) => (
            <article class="experience-card group relative ml-6 rounded-lg border border-white/10 bg-[#0a0a0a] p-4 transition-colors duration-200 ease-out hover:border-white/25 md:p-5">
              <!-- timeline dot -->
              <span class="absolute -left-[27px] top-6 flex size-3.5 items-center justify-center">
                <span class="size-1.5 rounded-full bg-white/40 transition-colors duration-200 group-hover:bg-[var(--sec)]" />
              </span>

              <div class="flex items-start justify-between gap-3">
                <span class="font-mono text-[10px] uppercase tracking-wider text-[var(--white-icon)]">
                  {experience.status}
                </span>

                <div class="flex items-center gap-1.5 shrink-0">
                  <a
                    target="_blank"
                    href={experience.link}
                    aria-label={`Open ${experience.company} GitHub`}
                    title="GitHub"
                    class="relative flex size-8 items-center justify-center rounded-md border border-white/10 bg-white/[0.02] text-[var(--white-icon)] transition-all duration-150 hover:border-white/20 hover:bg-white/[0.06] hover:text-white active:scale-95"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                      class="size-3.5"
                    >
                      <path d="M24 12L18.3431 17.6569L16.9289 16.2426L21.1716 12L16.9289 7.75736L18.3431 6.34315L24 12ZM2.82843 12L7.07107 16.2426L5.65685 17.6569L0 12L5.65685 6.34315L7.07107 7.75736L2.82843 12ZM9.78845 21H7.66009L14.2116 3H16.3399L9.78845 21Z" />
                    </svg>
                  </a>
                  <a
                    target="_blank"
                    href={experience.preview}
                    aria-label={`Open ${experience.company} preview`}
                    title="Preview"
                    class="relative flex size-8 items-center justify-center rounded-md border border-white/10 bg-white/[0.02] text-[var(--white-icon)] transition-all duration-150 hover:border-white/20 hover:bg-white/[0.06] hover:text-white active:scale-95"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                      class="size-3.5"
                    >
                      <path d="M16.0037 9.41421L7.39712 18.0208L5.98291 16.6066L14.5895 8H7.00373V6H18.0037V17H16.0037V9.41421Z" />
                    </svg>
                  </a>
                </div>
              </div>

              <h4 class="mt-3 text-xl font-semibold leading-tight text-white md:text-2xl">
                {experience.role}
              </h4>

              <div class="mt-1.5 flex flex-wrap items-baseline gap-x-2 gap-y-1 font-mono text-xs text-[var(--white-icon)] md:text-sm">
                <span class="text-[var(--white)]">{experience.company}</span>
                <span aria-hidden="true" class="opacity-40">/</span>
                <span>{experience.period}</span>
              </div>

              <p class="mt-3 max-w-prose text-sm leading-relaxed text-[var(--white-icon)] md:text-[0.95rem]">
                {experience.description}
              </p>

              {experience.skills && experience.skills.length > 0 && (
                <ul class="mt-4 flex flex-wrap gap-1.5">
                  {experience.skills.map((skill) => (
                    <li class="rounded border border-white/10 bg-white/[0.03] px-2 py-0.5 font-mono text-[11px] text-[var(--white-icon)]">
                      {skill}
                    </li>
                  ))}
                </ul>
              )}
            </article>
          ))
        }
      </div>
    </div>

    <a
      target="_blank"
      href="https://www.linkedin.com/in/muhammad-attar-syahputra/"
      aria-label="Resume"
      class="mt-10 flex w-full items-center justify-center gap-2 rounded-md border border-white/10 bg-white/[0.02] p-3 text-[var(--white-icon)] transition-colors duration-150 hover:border-white/20 hover:bg-white/[0.06] hover:text-white"
    >
      <span class="text-sm font-medium tracking-wide md:text-base">Resume</span>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="currentColor"
        class="size-4"
      >
        <path d="M16.0037 9.41421L7.39712 18.0208L5.98291 16.6066L14.5895 8H7.00373V6H18.0037V17H16.0037V9.41421Z" />
      </svg>
    </a>
  </div>
</section>