---
import LikeButton from "../React/LikeButton.tsx";

const currentYear = new Date().getFullYear();
---

<footer class="w-full border-t border-[#ffffff10] py-12 md:py-16">
  <div class="mx-auto max-w-5xl px-4 md:px-0">
    <div class="flex flex-col items-center gap-8 md:gap-10">
      <div class="flex items-center justify-center gap-5 sm:gap-6">
        {
          [
            {
              href: "https://github.com/AttarSaputra",
              icon: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-7"><path d="M12.001 2C6.47598 2 2.00098 6.475 2.00098 12C2.00098 16.425 4.86348 20.1625 8.83848 21.4875C9.33848 21.575 9.52598 21.275 9.52598 21.0125C9.52598 20.775 9.51348 19.9875 9.51348 19.15C7.00098 19.6125 6.35098 18.5375 6.15098 17.975C6.03848 17.6875 5.55098 16.8 5.12598 16.5625C4.77598 16.375 4.27598 15.9125 5.11348 15.9C5.90098 15.8875 6.46348 16.625 6.65098 16.925C7.55098 18.4375 8.98848 18.0125 9.56348 17.75C9.65098 17.1 9.91348 16.6625 10.201 16.4125C7.97598 16.1625 5.65098 15.3 5.65098 11.475C5.65098 10.3875 6.03848 9.4875 6.67598 8.7875C6.57598 8.5375 6.22598 7.5125 6.77598 6.1375C6.77598 6.1375 7.61348 5.875 9.52598 7.1625C10.326 6.9375 11.176 6.825 12.026 6.825C12.876 6.825 13.726 6.9375 14.526 7.1625C16.4385 5.8625 17.276 6.1375 17.276 6.1375C17.826 7.5125 17.476 8.5375 17.376 8.7875C18.0135 9.4875 18.401 10.375 18.401 11.475C18.401 15.3125 16.0635 16.1625 13.8385 16.4125C14.201 16.725 14.5135 17.325 14.5135 18.2625C14.5135 19.6 14.501 20.675 14.501 21.0125C14.501 21.275 14.6885 21.5875 15.1885 21.4875C19.259 20.1133 21.9999 16.2963 22.001 12C22.001 6.475 17.526 2 12.001 2Z"></path></svg>',
              label: "GitHub",
            },
            {
              href: "https://www.linkedin.com/in/muhammad-attar-syahputra/",
              icon: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-7"><path d="M18.3362 18.339H15.6707V14.1622C15.6707 13.1662 15.6505 11.8845 14.2817 11.8845C12.892 11.8845 12.6797 12.9683 12.6797 14.0887V18.339H10.0142V9.75H12.5747V10.9207H12.6092C12.967 10.2457 13.837 9.53325 15.1367 9.53325C17.8375 9.53325 18.337 11.3108 18.337 13.6245V18.339H18.3362ZM7.00373 8.57475C6.14573 8.57475 5.45648 7.88025 5.45648 7.026C5.45648 6.1725 6.14648 5.47875 7.00373 5.47875C7.85873 5.47875 8.55173 6.1725 8.55173 7.026C8.55173 7.88025 7.85798 8.57475 7.00373 8.57475ZM8.34023 18.339H5.66723V9.75H8.34023V18.339ZM19.6697 3H4.32923C3.59498 3 3.00098 3.5805 3.00098 4.29675V19.7033C3.00098 20.4202 3.59498 21 4.32923 21H19.6675C20.401 21 21.001 20.4202 21.001 19.7033V4.29675C21.001 3.5805 20.401 3 19.6675 3H19.6697Z"></path></svg>',
              label: "LinkedIn",
            },
            {
              href: "http://wa.me/6283119763537",
              icon: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-7"><path d="M20.52 3.48A11.4 11.4 0 0 0 12.12 1.5C6.3 1.5 1.5 6.3 1.5 12.12c0 2.04.54 4.02 1.56 5.76L1.5 22.5l4.68-1.5c1.68.9 3.6 1.38 5.58 1.38h.06c5.82 0 10.62-4.8 10.62-10.62 0-2.82-1.08-5.52-3.12-7.56ZM12.12 19.5h-.06c-1.74 0-3.42-.48-4.86-1.32L6.48 18.6l-.9-3.12 1.2-.36A8.1 8.1 0 0 1 3.9 12.12c0-4.44 3.6-8.04 8.04-8.04 2.14 0 4.14.84 5.64 2.34 1.5 1.5 2.34 3.48 2.34 5.64 0 4.44-3.6 8.04-8.04 8.04Zm4.44-6.06c-.24-.12-1.44-.72-1.68-.78-.24-.06-.42-.06-.6.06-.18.12-.72.78-.9.96-.18.18-.36.2-.6.06-.24-.12-1.02-.36-1.92-1.2-.72-.66-1.2-1.5-1.32-1.74-.12-.24-.02-.42.12-.54.12-.12.24-.3.36-.48.12-.18.18-.3.3-.48.12-.18.06-.3 0-.42-.06-.12-.6-1.44-.84-1.98-.2-.48-.42-.42-.6-.42h-.48c-.18 0-.42.06-.66.3-.24.24-1.02 1.02-1.02 2.52s1.02 2.94 1.2 3.12c.18.18 2.04 3.12 4.98 4.38.72.3 1.26.48 1.68.6.72.24 1.38.18 1.92.12.6-.06 1.86-.72 2.1-1.44.24-.72.24-1.32.18-1.44-.06-.12-.24-.18-.48-.3Z"></path></svg>',
              label: "WhatsApp",
            },
            {
              href: "mailto:ataryk25@gmail.com",
              icon: '<svg xmlns="http://www.w3.org/2000/svg" width="2.1em" height="2.1em" viewBox="0 0 24 24"><path fill="currentColor" d="m18.73 5.41l-1.28 1L12 10.46L6.55 6.37l-1.28-1A2 2 0 0 0 2 7.05v11.59A1.36 1.36 0 0 0 3.36 20h3.19v-7.72L12 16.37l5.45-4.09V20h3.19A1.36 1.36 0 0 0 22 18.64V7.05a2 2 0 0 0-3.27-1.64"/></svg>',
              label: "Email",
            },
          ].map((link) => (
            <a
              href={link.href}
              target="_blank"
              aria-label={link.label}
              class="inline-flex h-16 w-16 items-center justify-center rounded-full border border-white/20 bg-white/[0.02] text-white/80 transition duration-300 ease-out hover:-translate-y-0.5 hover:border-[rgba(93,169,255,0.5)] hover:text-white"
            >
              <div set:html={link.icon} class="text-current" />
            </a>
          ))
        }
      </div>

      <p class="text-center text-[10px] uppercase tracking-[0.18em] text-white/70 md:text-xs">
        Dibuat oleh <span class="font-medium text-[var(--sec)]">Muhammad Attar Syahputra</span> menggunakan
        <span class="inline-flex items-center gap-1.5 align-middle font-medium text-[#ff8a3d]">
          <svg viewBox="0 0 64 64" aria-hidden="true" class="h-3.5 w-3.5 drop-shadow-[0_0_10px_rgba(255,138,61,0.55)]">
            <defs>
              <linearGradient id="astro-logo-footer" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#FFB066" />
                <stop offset="50%" stop-color="#FF7A18" />
                <stop offset="100%" stop-color="#FF5E2F" />
              </linearGradient>
            </defs>
            <path
              d="M32 5L52 49H44L39 39H25L20 49H12L32 5ZM29 31H35L32 21L29 31Z"
              fill="url(#astro-logo-footer)"
            />
            <circle cx="32" cy="51" r="6" fill="#FF8A3D" />
          </svg>
          <span class="bg-gradient-to-r from-[#ffb066] via-[#ff8a3d] to-[#ff5e2f] bg-clip-text text-transparent">Astro</span>
        </span>
      </p>
      <div class="hidden">
        <LikeButton client:load />
      </div>
    </div>
  </div>
</footer>
